cd swstp_edge && python3 -c "
import serial, time
s = serial.Serial('/dev/serial0', 115200, timeout=0.2)
s.write(bytes([0xB5,0x62,0x06,0x08,0x06,0x00,0xC8,0x00,0x01,0x00,0x01,0x00,0xDE,0x6A]))
time.sleep(0.5); s.reset_input_buffer()
t = time.time(); n = 0
while time.time() - t < 5:
    if b'GGA' in s.readline(): n += 1
print(f'GGA per second: {n/5:.1f}  (5.0 = 5 Hz working, 1.0 = ignored)')
"
