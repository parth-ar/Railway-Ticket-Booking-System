# /etc/systemd/system/swstp-power-switch.service
[Unit]
Description=SWSTP Safe Power Switch
After=local-fs.target
Before=swstp-edge.service
Before=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/swstp-power-switch.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
